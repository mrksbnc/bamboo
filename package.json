{
	"name": "@mrksbnc/bamboo",
	"version": "1.3.0",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"docs:build": "turbo run build --filter=@workspace/bamboo-docs",
		"docs:dev": "turbo run docs:dev",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"ib": "pnpm install && pnpm build",
		"lint": "run-p lint:*",
		"lint:oxlint": "oxlint --fix",
		"lint:spell": "cspell --config ./cspell.yaml \"**/*.{ts,md,json,vue}\" --verbose",
		"prepare": "husky",
		"purge": "turbo run purge && rm -rf node_modules .turbo",
		"size": "size-limit",
		"test": "turbo run test",
		"type-check": "turbo run type-check",
		"update:pnpm": "corepack use pnpm@latest"
	},
	"devDependencies": {
		"@cspell/dict-vue": "^3.0.5",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@size-limit/file": "^13.1.1",
		"@size-limit/preset-big-lib": "^13.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "5.0.0",
		"@vue/test-utils": "^2.5.0",
		"@vueuse/core": "^14.4.0",
		"cspell": "^10.3.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"npm-run-all2": "^9.0.3",
		"oxfmt": "^0.67.0",
		"oxlint": "~1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"postcss": "^8.5.28",
		"semantic-release": "^25.0.9",
		"size-limit": "^13.1.1",
		"tailwindcss": "^4.3.3",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"vite": "8.3.0",
		"vite-plugin-dts": "^5.1.0",
		"vitest": "^5.0.0",
		"vitest-axe": "^0.1.0",
		"vue": "^3.5.42",
		"vue-tsc": "^3.3.11"
	},
	"size-limit": [
		{
			"path": "packages/bamboo-vue/dist/index.es.js",
			"limit": "300 kB"
		},
		{
			"path": "packages/bamboo-vue/dist/lib.css",
			"limit": "100 kB"
		},
		{
			"path": "packages/bamboo-core/dist/index.es.js",
			"limit": "300 kB"
		}
	],
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
